# === Punt Labs canonical .gitignore ===
# Source of truth: .bin/gitignore-canonical.template
# Rollout:         .bin/gitignore-canonical-rollout.sh
# Repo-specific additions belong BELOW the "# === Repo-specific ===" marker.
# Everything above it is managed by the rollout script.

# --- Secrets & local overrides ---
.env
.env.*
.env*.local
!.env.example
.envrc.local
.biff.local
.claude/settings.local.json
.claude/settings.local.*
.claude/mcp.local.json
.mcp.local.json
*.local
*.local.*
.*.local
.*.local.*

# --- Punt Labs runtime state (never commit) ---
.punt-labs/local/
.punt-labs/**/local/**
.punt-labs/**/*.local.*
.punt-labs/quarry/captures/
.punt-labs/vox/ephemeral/
.punt-labs/vox/vox.local.md
.punt-labs/lux.md

# --- Claude Code runtime state ---
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/hooks/
!.claude/agents/
!.claude/rules/
!.claude/skills/
.claude/scheduled_tasks*
.claude/worktrees/
.claude/projects/
.claude/beadle.poll.*
*/**/.claude/

# --- Lock files (except uv.lock) ---
.*.lock
*.punt-import.lock
.CLAUDE.md.lock
.CLAUDE.md.punt-import.lock
**/.create.lock

# --- Beads runtime state ---
.beads/bd.sock*
.beads/beads.db*
.beads/daemon-*
.beads/daemon.log
.beads/daemon-error
.beads/.local_version

# --- Scratch / temp ---
.tmp/*
!.tmp/.gitkeep
*.tmp
CLAUDE.md.tmp

# --- Worktrees ---
.worktrees/

# --- OS junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# --- Editors / IDEs ---
.idea/
.vscode/
.cursor/
.codex/
.accio/
.claude-flow/
*.swp
*.swo
*~

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
dist/
build/
*.egg
*.egg-info/
.eggs/
.mypy_cache/
.pyright/
.pytest_cache/
.pytest-work/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
uv.toml

# --- Node / web ---
node_modules/
.astro/
.vercel/

# --- Go ---
coverage.out
*.test

# --- Swift / Xcode ---
# (Do NOT ignore *.xcodeproj / *.xcworkspace — those directories are tracked;
# only ignore user-specific state INSIDE them.)
xcuserdata/
DerivedData/
CoverageDerived/
*.xccheckout
*.xcresult
*.xcscmblueprint
*.hmap
*.dSYM
*.dSYM.zip
*.ipa
.swiftpm/
Package.pin
Package.resolved
Carthage/Build/
Carthage/Checkout
Pods/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
iOSInjectionProject/
playground.xcworkspace
timeline.xctimeline

# --- LaTeX build artifacts ---
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# === Repo-specific ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/

# Data (large files, generated)
*.lance

# Input files (large PDFs)
inputs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Coverage
htmlcov/
.coverage
.coverage.*

# mypy
.mypy_cache/

# pytest
.pytest_cache/
.pytest-work/

# ruff
.ruff_cache/

# punt-kit writes this lock beside its CLAUDE.md import; it is machine state,
# not project content, and an over-broad `git add -A` will otherwise sweep it in.
.CLAUDE.md.lock

# Scratch notes dropped at the repo root. Real scratch belongs in .tmp/.
/Sample of *.txt

# Environment

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.pk

# Claude Flow (deprecated)
.claude-flow/

# OS
.DS_Store

# Claude Code (settings.json is tracked; everything else is local/runtime).
# Exclude the CONTENTS, not the directory: git does not descend into an
# excluded directory, so a negation under `.claude/` can never re-include.
*/**/.claude/

# Scratch/temp directory (TMPDIR set via .envrc)

# Clean-machine install harness — staged working-tree wheel (built at run time)
tests/harness/.stage/

# Plugin runtime state (tts, biff)
.tts/

# Legacy plugin state at repo root — biff/lux/ethos config now lives under
# .punt-labs/<tool>/ (see .punt-labs/biff/, .punt-labs/lux.md,
# .punt-labs/ethos.yaml) or resolves from the global ~/.punt-labs/. These
# root-level paths predate that convention and should not be recreated.
/.biff
/.lux/
/.ethos/

# Dev scratch files
*.tmp
prfaq*.bbl
prfaq*.bcf
prfaq*.blg
prfaq*.run.xml

# MCP project-local
.mcp.json

# Local uv overrides (depot find-links, etc.)
uv.toml
/Lux.ini
# Capture files — pending scrub review before committing

# DES-058 machine-local live zone — never track. Session audit/lock files are
# live-rewritten per session and deadlock git if tracked; ethos enable seeds this.

# punt-kit CLAUDE.md import lock — a machine-local artifact, never a repo file.
.CLAUDE.md.punt-import.lock

# vox machine-local config (the enabled marker and vox.md ship; local prefs do not)

# Ethos org registry — was a git submodule here (~1 MB / 246 files: identities,
# personalities, writing styles, talents, roles, teams). Quarry ships as a
# marketplace plugin and Claude Code clones plugin repos with
# --recurse-submodules, so the whole org roster landed on every consumer's disk
# as a gitlink. Now a pruned, plain-file vendored copy (quarry-teuk) — the
# lux/cryptd pattern, not a submodule — scoped to the 8 identities the quarry
# team roster needs. Only machine-local runtime state is ignored below; the
# vendored registry itself is tracked.
.punt-labs/ethos/missions/
.punt-labs/ethos/missions.jsonl
.punt-labs/ethos/sessions/
.punt-labs/ethos/.biff
