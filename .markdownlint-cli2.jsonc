{
  "ignores": [
    ".beads/",
    ".claude/",
    // The vendored ethos registry (DES-054) is copied verbatim from
    // punt-labs/team — upstream's markdown is not ours to lint.
    ".punt-labs/ethos/",
    ".punt-labs/quarry/captures/",
    ".venv/",
    ".tmp/",
    ".pytest-work/",
    "dist/",
    "node_modules/"
  ],
  "overrides": [
    {
      "files": ["tests/fixtures/*.md"],
      "config": {
        // Test fixtures intentionally use multiple h1 headings
        "MD025": false
      }
    }
  ]
}
